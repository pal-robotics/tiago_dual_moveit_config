<?xml version="1.0" ?>
<robot name="tiago_dual" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_omni_no-ee_no-ee.srdf.xacro" />
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_omni_robotiq-2f-140_schunk-ft_no-arm-right.srdf.xacro" />
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_omni_no-arm-left_no-ee.srdf.xacro" />
    <disable_collisions link1="arm_right_2_link" link2="gripper_left_left_outer_knuckle" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_left_inner_finger" reason="Never"/>
    <disable_collisions link1="arm_right_tool_link" link2="gripper_left_right_inner_finger" reason="Never"/>
    <disable_collisions link1="base_front_laser_link" link2="gripper_left_right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="gripper_left_right_inner_knuckle" link2="wheel_rear_right_link" reason="Never"/>
    <disable_collisions link1="gripper_left_right_outer_finger" link2="wheel_rear_right_link" reason="Never"/>
</robot>
