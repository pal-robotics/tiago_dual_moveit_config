<?xml version="1.0" ?>
<robot name="tiago_dual" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_no-ee_no-ee.srdf.xacro" />
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_robotiq-2f-140_schunk-ft_no-arm-right.srdf.xacro" />
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_no-arm-left_custom.srdf.xacro" />
    <disable_collisions link1="caster_back_left_2_link" link2="wrist_left_ft_link" reason="Never"/>
    <disable_collisions link1="caster_back_right_2_link" link2="gripper_left_base_link" reason="Never"/>
</robot>
