<?xml version="1.0" ?>
<robot name="tiago_dual" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_no-ee_no-ee.srdf.xacro" />
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_no-ee_no-arm-right.srdf.xacro" />
  <xacro:include filename="$(find tiago_dual_moveit_config)/config/srdf/disable_collisions/tiago_dual_no-arm-left_robotiq-2f-85_schunk-ft.srdf.xacro" />
    <disable_collisions link1="arm_left_tool_link" link2="gripper_right_left_inner_finger_pad" reason="Never"/>
    <disable_collisions link1="arm_left_tool_link" link2="gripper_right_right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="arm_left_tool_link" link2="wrist_right_ft_link" reason="Never"/>
    <disable_collisions link1="arm_left_tool_link" link2="wrist_right_ft_tool_link" reason="Never"/>
    <disable_collisions link1="caster_back_left_2_link" link2="gripper_right_right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="caster_front_left_2_link" link2="gripper_right_left_outer_knuckle" reason="Never"/>
</robot>
